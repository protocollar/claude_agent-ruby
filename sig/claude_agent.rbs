  # Permission types
  type permission_result = PermissionResultAllow | PermissionResultDeny

  PERMISSION_UPDATE_TYPES: Array[String]
  PERMISSION_UPDATE_DESTINATIONS: Array[String]

  class PermissionResultAllow < ImmutableRecord
    attr_reader updated_input: Hash[String, untyped]?
    attr_reader updated_permissions: Array[PermissionUpdate]?
    attr_reader tool_use_id: String?

    def initialize: (?updated_input: Hash[String, untyped]?, ?updated_permissions: Array[PermissionUpdate]?, ?tool_use_id: String?) -> void
    def behavior: () -> "allow"
    def to_h: () -> Hash[Symbol, untyped]
  end

  class PermissionResultDeny < ImmutableRecord
    attr_reader message: String
    attr_reader interrupt: bool
    attr_reader tool_use_id: String?

    def initialize: (?message: String, ?interrupt: bool, ?tool_use_id: String?) -> void
    def behavior: () -> "deny"
    def to_h: () -> Hash[Symbol, untyped]
  end

  class PermissionUpdate < ImmutableRecord
    attr_reader type: String
    attr_reader rules: Array[PermissionRuleValue]?
    attr_reader behavior: String?
    attr_reader mode: String?
    attr_reader directories: Array[String]?
    attr_reader destination: String?

    def initialize: (type: String, ?rules: Array[PermissionRuleValue]?, ?behavior: String?, ?mode: String?, ?directories: Array[String]?, ?destination: String?) -> void
    def to_h: () -> Hash[Symbol, untyped]
  end

  class PermissionRuleValue < ImmutableRecord
    attr_reader tool_name: String?
    attr_reader rule_content: String?

    def initialize: (?tool_name: String?, ?rule_content: String?) -> void
    def to_h: () -> Hash[Symbol, untyped]
  end

  class ToolPermissionContext < ImmutableRecord
    attr_reader permission_suggestions: untyped
    attr_reader blocked_path: String?
    attr_reader decision_reason: String?
    attr_reader tool_use_id: String?
    attr_reader agent_id: String?
    attr_reader signal: AbortSignal?
    attr_reader description: String?
    attr_reader title: String?
    attr_reader display_name: String?
    attr_reader request: PermissionRequest?

    def initialize: (?permission_suggestions: untyped, ?blocked_path: String?, ?decision_reason: String?, ?tool_use_id: String?, ?agent_id: String?, ?signal: AbortSignal?, ?description: String?, ?title: String?, ?display_name: String?, ?request: PermissionRequest?) -> void
  end

  # Deferred permission request resolved from any thread
  class PermissionRequest
    attr_reader tool_name: String
    attr_reader input: Hash[Symbol, untyped]
    attr_reader context: ToolPermissionContext?
    attr_reader request_id: String
    attr_reader created_at: Time

    def initialize: (tool_name: String, input: Hash[Symbol, untyped], context: ToolPermissionContext?, request_id: String) -> void
    def allow!: (?updated_input: Hash[Symbol, untyped]?, ?updated_permissions: Array[PermissionUpdate]?) -> void
    def deny!: (?message: String, ?interrupt: bool) -> void
    def defer!: () -> self
    def deferred?: () -> bool
    def resolved?: () -> bool
    def pending?: () -> bool
    def result: () -> permission_result?
    def wait: (?timeout: Numeric?) -> permission_result
    def display_label: () -> String
    def summary: (?max: Integer) -> String
    def inspect: () -> String
  end

  # Thread-safe queue of pending permission requests
  class PermissionQueue
    def initialize: () -> void
    def poll: () -> PermissionRequest?
    def pop: (?timeout: Numeric?) -> PermissionRequest?
    def empty?: () -> bool
    def size: () -> Integer
    def push: (PermissionRequest request) -> void
    def drain!: (?reason: String) -> Array[PermissionRequest]
  end

  # Cumulative usage tracking across conversation turns
  class CumulativeUsage
    attr_reader input_tokens: Integer
    attr_reader output_tokens: Integer
    attr_reader cache_read_input_tokens: Integer
    attr_reader cache_creation_input_tokens: Integer
    attr_reader total_cost_usd: Float
    attr_reader num_turns: Integer
    attr_reader duration_ms: Integer
    attr_reader duration_api_ms: Integer

    def initialize: () -> void
    def track: (untyped message) -> void
    def reset!: () -> void
    def to_h: () -> Hash[Symbol, Integer | Float]
  end

  # Represents a complete agent turn
  class TurnResult
    attr_reader messages: Array[message]

    def initialize: () -> void
    def <<: (message) -> self
    def result: () -> ResultMessage?
    def complete?: () -> bool

    # Text & thinking
    def text: () -> String
    def thinking: () -> String

    # Tool use
    def tool_uses: () -> Array[ToolUseBlock | ServerToolUseBlock]
    def tool_results: () -> Array[ToolResultBlock | ServerToolResultBlock]
    def tool_executions: () -> Array[Hash[Symbol, ToolUseBlock | ServerToolUseBlock | ToolResultBlock | ServerToolResultBlock | nil]]

    # Result accessors
    def usage: () -> Hash[Symbol, Integer]?
    def cost: () -> Float?
    def duration_ms: () -> Integer?
    def duration_api_ms: () -> Integer?
    def session_id: () -> String?
    def num_turns: () -> Integer?
    def stop_reason: () -> String?
    def model: () -> String?
    def model_usage: () -> Hash[String, untyped]?
    def structured_output: () -> untyped
    def permission_denials: () -> Array[SDKPermissionDenial]
    def errors: () -> Array[String]

    # Status
    def success?: () -> bool
    def error?: () -> bool
    def subtype: () -> String?

    # Filtered message access
    def assistant_messages: () -> Array[AssistantMessage]
    def user_messages: () -> Array[UserMessage | UserMessageReplay]
    def stream_events: () -> Array[StreamEvent]
    def content_blocks: () -> Array[content_block]

    def inspect: () -> String
  end

  # Event handler for dispatching typed events from message streams
  class EventHandler
    TYPE_EVENTS: Array[Symbol]
    DECOMPOSED_EVENTS: Array[Symbol]
    META_EVENTS: Array[Symbol]
    EVENTS: Array[Symbol]

    def initialize: () -> void
    def on: (Symbol event) { (*untyped) -> void } -> self

    # Meta events
    def on_message: () { (message) -> void } -> self

    # Type-based events
    def on_user: () { (UserMessage | UserMessageReplay) -> void } -> self
    def on_assistant: () { (AssistantMessage) -> void } -> self
    def on_system: () { (SystemMessage) -> void } -> self
    def on_result: () { (ResultMessage) -> void } -> self
    def on_stream_event: () { (StreamEvent) -> void } -> self
    def on_compact_boundary: () { (CompactBoundaryMessage) -> void } -> self
    def on_status: () { (StatusMessage) -> void } -> self
    def on_tool_progress: () { (ToolProgressMessage) -> void } -> self
    def on_hook_response: () { (HookResponseMessage) -> void } -> self
    def on_auth_status: () { (AuthStatusMessage) -> void } -> self
    def on_task_notification: () { (TaskNotificationMessage) -> void } -> self
    def on_hook_started: () { (HookStartedMessage) -> void } -> self
    def on_hook_progress: () { (HookProgressMessage) -> void } -> self
    def on_tool_use_summary: () { (ToolUseSummaryMessage) -> void } -> self
    def on_task_started: () { (TaskStartedMessage) -> void } -> self
    def on_task_progress: () { (TaskProgressMessage) -> void } -> self
    def on_rate_limit_event: () { (RateLimitEvent) -> void } -> self
    def on_prompt_suggestion: () { (PromptSuggestionMessage) -> void } -> self
    def on_files_persisted: () { (FilesPersistedEvent) -> void } -> self

    # Decomposed events
    def on_text: () { (String) -> void } -> self
    def on_thinking: () { (String) -> void } -> self
    def on_tool_use: () { (ToolUseBlock | ServerToolUseBlock) -> void } -> self
    def on_tool_result: () { (ToolResultBlock | ServerToolResultBlock, (ToolUseBlock | ServerToolUseBlock)?) -> void } -> self

    def handle: (message) -> void
    def reset!: () -> void
    def has_handlers?: () -> bool
  end

  # A single tool execution in the conversation timeline
  class ToolActivity < ImmutableRecord
    attr_reader tool_use: ToolUseBlock | ServerToolUseBlock
    attr_reader tool_result: ToolResultBlock | ServerToolResultBlock | nil
    attr_reader turn_index: Integer
    attr_reader started_at: Time?
    attr_reader completed_at: Time?

    def initialize: (tool_use: ToolUseBlock | ServerToolUseBlock, ?tool_result: ToolResultBlock | ServerToolResultBlock | nil, turn_index: Integer, ?started_at: Time?, ?completed_at: Time?) -> void
    def name: () -> String
    def display_label: () -> String
    def summary: (?max: Integer) -> String
    def file_path: () -> String?
    def id: () -> String
    def error?: () -> bool
    def complete?: () -> bool
    def duration: () -> Float?
  end

  # Mutable wrapper around a ToolUseBlock for real-time status tracking
  class LiveToolActivity
    attr_reader tool_use: ToolUseBlock | ServerToolUseBlock
    attr_reader tool_result: ToolResultBlock | ServerToolResultBlock | nil
    attr_reader status: Symbol
    attr_reader started_at: Time
    attr_reader elapsed: Float?

    def initialize: (ToolUseBlock | ServerToolUseBlock tool_use) -> void
    def id: () -> String
    def name: () -> String
    def input: () -> Hash[Symbol | String, untyped]
    def display_label: () -> String
    def summary: (?max: Integer) -> String
    def file_path: () -> String?
    def complete!: (ToolResultBlock | ServerToolResultBlock result) -> void
    def update_elapsed: (Float seconds) -> void
    def running?: () -> bool
    def done?: () -> bool
    def error?: () -> bool
    def complete?: () -> bool
    def to_h: () -> Hash[Symbol, untyped]
    def inspect: () -> String
  end

  # Enumerable collection of LiveToolActivity entries with auto-wiring
  class ToolActivityTracker
    include Enumerable[LiveToolActivity]

    def self.attach: (EventHandler | Client target) -> ToolActivityTracker

    def initialize: () -> void
    def on_start: () { (LiveToolActivity) -> void } -> self
    def on_complete: () { (LiveToolActivity) -> void } -> self
    def on_progress: () { (LiveToolActivity) -> void } -> self
    def on_change: () { (Symbol, LiveToolActivity) -> void } -> self
    def each: () { (LiveToolActivity) -> void } -> void
            | () -> Enumerator[LiveToolActivity, void]
    def size: () -> Integer
    def empty?: () -> bool
    def find_by_id: (String id) -> LiveToolActivity?
    def []: (String id) -> LiveToolActivity?
    def running: () -> Array[LiveToolActivity]
    def done: () -> Array[LiveToolActivity]
    def errored: () -> Array[LiveToolActivity]
    def reset!: () -> void
  end

  # High-level conversation interface managing the full lifecycle
  class Conversation
    CONVERSATION_KEYS: Array[Symbol]
    CALLBACK_ALIASES: Hash[Symbol, Symbol]

    attr_reader turns: Array[TurnResult]
    attr_reader messages: Array[message]
    attr_reader tool_activity: Array[ToolActivity]
    attr_reader client: Client
    attr_reader tool_tracker: ToolActivityTracker?

    def self.open: (**untyped) { (Conversation) -> void } -> void
    def self.resume: (String session_id, **untyped) -> Conversation

    def initialize: (**untyped) -> void
    def say: (String | Array[content_block] prompt) -> TurnResult
           | (String | Array[content_block] prompt) { (message) -> void } -> TurnResult
    def total_cost: () -> Float
    def session_id: () -> String?
    def usage: () -> CumulativeUsage
    def pending_permission: () -> PermissionRequest?
    def pending_permissions?: () -> bool
    def close: () -> void
    def open?: () -> bool
    def closed?: () -> bool
    def inspect: () -> String
  end

  # Session discovery
  def self.list_sessions: (?dir: String?, ?limit: Integer?, ?offset: Integer?, ?include_worktrees: bool) -> Array[SessionInfo]
  def self.get_session_messages: (String session_id, ?dir: String?, ?limit: Integer?, ?offset: Integer?) -> Array[SessionMessage]
  def self.rename_session: (String session_id, String title, ?dir: String?) -> void
  def self.tag_session: (String session_id, String? tag, ?dir: String?) -> void
  def self.get_session_info: (String session_id, ?dir: String?) -> SessionInfo?
  def self.fork_session: (String session_id, ?up_to_message_id: String?, ?title: String?, ?dir: String?) -> ForkSessionResult

  # Shared session path infrastructure
  module SessionPaths
    MAX_SLUG_LENGTH: Integer
    UUID_PATTERN: Regexp

    def self.config_dir: () -> String
    def self.projects_dir: () -> String
    def self.project_dir_for: (String path) -> String
    def self.encode_project_dir: (String path) -> String
    def self.java_string_hash: (String str) -> String
    def self.find_project_dir: (String path) -> String?
    def self.realpath: (String path) -> String
    def self.git_worktrees: (String dir) -> Array[String]
  end

  # ListSessions module
  module ListSessions
    BUFFER_SIZE: Integer

    def self.call: (?dir: String?, ?limit: Integer?, ?offset: Integer?) -> Array[SessionInfo]
  end

  # GetSessionMessages module (TypeScript SDK v0.2.59 parity)
  module GetSessionMessages
    PARSEABLE_TYPES: Array[String]

    def self.call: (String session_id, ?dir: String?, ?limit: Integer?, ?offset: Integer?) -> Array[SessionMessage]
  end

  # Session mutations module (TypeScript SDK v0.2.75 parity)
  module SessionMutations
    UNICODE_SANITIZE_PATTERN: Regexp

    def self.rename_session: (String session_id, String title, ?dir: String?) -> void
    def self.tag_session: (String session_id, String? tag, ?dir: String?) -> void
  end

  # Single session lookup (TypeScript SDK v0.2.75 parity)
  module GetSessionInfo
    def self.call: (String session_id, ?dir: String?) -> SessionInfo?
  end

  # Session forking (TypeScript SDK v0.2.76 parity)
  module ForkSession
    UUID_FIELDS: Array[String]
    SESSION_ID_FIELDS: Array[String]

    def self.call: (String session_id, ?up_to_message_id: String?, ?title: String?, ?dir: String?) -> ForkSessionResult
  end

  # Convenience methods
  def self.conversation: (**untyped) -> Conversation
  def self.resume_conversation: (String session_id, **untyped) -> Conversation

  # Client
  class Client
    module Commands
    end

    include Commands

    attr_reader options: Options
    attr_reader transport: Transport::Base
    attr_reader server_info: Hash[String, untyped]?
    attr_reader cumulative_usage: CumulativeUsage
    attr_reader event_handler: EventHandler
    attr_reader permission_queue: PermissionQueue

    def self.open: (?options: Options?, ?transport: Transport::Base?, ?prompt: String?) { (Client) -> void } -> void

    def initialize: (?options: Options?, ?transport: Transport::Base?) -> void
    def connect: (?prompt: String?) -> void
    def disconnect: () -> void
    def connected?: () -> bool
    def send_message: (String | Array[content_block] content, ?session_id: String, ?uuid: String?) -> void
    alias query send_message
    def on: (Symbol event) { (*untyped) -> void } -> self

    # Meta events
    def on_message: () { (message) -> void } -> self

    # Type-based events
    def on_user: () { (UserMessage | UserMessageReplay) -> void } -> self
    def on_assistant: () { (AssistantMessage) -> void } -> self
    def on_system: () { (SystemMessage) -> void } -> self
    def on_result: () { (ResultMessage) -> void } -> self
    def on_stream_event: () { (StreamEvent) -> void } -> self
    def on_compact_boundary: () { (CompactBoundaryMessage) -> void } -> self
    def on_status: () { (StatusMessage) -> void } -> self
    def on_tool_progress: () { (ToolProgressMessage) -> void } -> self
    def on_hook_response: () { (HookResponseMessage) -> void } -> self
    def on_auth_status: () { (AuthStatusMessage) -> void } -> self
    def on_task_notification: () { (TaskNotificationMessage) -> void } -> self
    def on_hook_started: () { (HookStartedMessage) -> void } -> self
    def on_hook_progress: () { (HookProgressMessage) -> void } -> self
    def on_tool_use_summary: () { (ToolUseSummaryMessage) -> void } -> self
    def on_task_started: () { (TaskStartedMessage) -> void } -> self
    def on_task_progress: () { (TaskProgressMessage) -> void } -> self
    def on_rate_limit_event: () { (RateLimitEvent) -> void } -> self
    def on_prompt_suggestion: () { (PromptSuggestionMessage) -> void } -> self
    def on_files_persisted: () { (FilesPersistedEvent) -> void } -> self

    # Decomposed events
    def on_text: () { (String) -> void } -> self
    def on_thinking: () { (String) -> void } -> self
    def on_tool_use: () { (ToolUseBlock | ServerToolUseBlock) -> void } -> self
    def on_tool_result: () { (ToolResultBlock | ServerToolResultBlock, (ToolUseBlock | ServerToolUseBlock)?) -> void } -> self

    def receive_messages: () { (message) -> void } -> void
                        | () -> Enumerator[message, void]
    def receive_response: () { (message) -> void } -> void
                        | () -> Enumerator[message, void]
    def receive_turn: () -> TurnResult
                    | () { (message) -> void } -> TurnResult
    def send_and_receive: (String | Array[content_block] content, ?session_id: String, ?uuid: String?) -> TurnResult
                        | (String | Array[content_block] content, ?session_id: String, ?uuid: String?) { (message) -> void } -> TurnResult
    def stream_input: (Enumerable[String | Hash[String, untyped] | UserMessage] stream, ?session_id: String) -> void
                    | (Enumerable[String | Hash[String, untyped] | UserMessage] stream, ?session_id: String) { (message) -> void } -> void
    def interrupt: () -> void
    def abort!: (?String? reason) -> void
    def set_permission_mode: (String mode) -> Hash[String, untyped]
    def set_model: (String? model) -> Hash[String, untyped]
    def rewind_files: (String user_message_id, ?dry_run: bool) -> RewindFilesResult
    def set_max_thinking_tokens: (Integer? tokens) -> Hash[String, untyped]
    def set_mcp_servers: (Hash[String, untyped] servers) -> McpSetServersResult
    def mcp_reconnect: (String server_name) -> Hash[String, untyped]
    def mcp_toggle: (String server_name, enabled: bool) -> Hash[String, untyped]
    def mcp_authenticate: (String server_name) -> Hash[String, untyped]
    def mcp_clear_auth: (String server_name) -> Hash[String, untyped]
    def stop_task: (String task_id) -> Hash[String, untyped]
    def apply_flag_settings: (Hash[String, untyped] settings) -> Hash[String, untyped]
    def supported_commands: () -> Array[SlashCommand]
    def supported_models: () -> Array[ModelInfo]
    def supported_agents: () -> Array[AgentInfo]
    def mcp_server_status: () -> Array[McpServerStatus]
    def account_info: () -> AccountInfo
    def initialization_result: () -> InitializationResult
    def cancel_async_message: (String message_uuid) -> Hash[String, untyped]
    def get_settings: () -> Hash[String, untyped]
    def pending_permission: () -> PermissionRequest?
    def pending_permissions?: () -> bool
  end

  # Control protocol
  class ControlProtocol
    DEFAULT_TIMEOUT: Integer
    REQUEST_ID_PREFIX: String
    HOOK_RESPONSE_KEYS: Hash[Symbol, String]

    # Mixin modules that compose the protocol's behavior
    module Primitives
    end

    module Lifecycle
    end

    module Messaging
    end

    module Commands
    end

    module RequestHandling
    end

    include Primitives
    include Lifecycle
    include Messaging
    include Commands
    include RequestHandling

    attr_reader transport: Transport::Base
    attr_reader options: Options
    attr_reader server_info: Hash[String, untyped]?
    attr_accessor permission_queue: PermissionQueue?

    def initialize: (transport: Transport::Base, ?options: Options?) -> void
    def start: (?streaming: bool, ?prompt: String?) -> Hash[String, untyped]?
    def stop: () -> void
    def abort!: () -> void
    def send_user_message: (String | Array[content_block] content, ?session_id: String, ?uuid: String?) -> void
    def each_message: () { (message) -> void } -> void
                    | () -> Enumerator[message, void]
    def receive_response: () { (message) -> void } -> void
                        | () -> Enumerator[message, void]
    def stream_input: (Enumerable[String | Hash[String, untyped] | UserMessage] stream, ?session_id: String) -> void
    def stream_conversation: (Enumerable[String | Hash[String, untyped] | UserMessage] stream, ?session_id: String) { (message) -> void } -> void
    def interrupt: () -> void
    def set_permission_mode: (String mode) -> Hash[String, untyped]
    def set_model: (String? model) -> Hash[String, untyped]
    def rewind_files: (String user_message_id, ?dry_run: bool) -> RewindFilesResult
    def set_max_thinking_tokens: (Integer? tokens) -> Hash[String, untyped]
    def set_mcp_servers: (Hash[String, untyped] servers) -> McpSetServersResult
    def mcp_reconnect: (String server_name) -> Hash[String, untyped]
    def mcp_toggle: (String server_name, enabled: bool) -> Hash[String, untyped]
    def mcp_authenticate: (String server_name) -> Hash[String, untyped]
    def mcp_clear_auth: (String server_name) -> Hash[String, untyped]
    def stop_task: (String task_id) -> Hash[String, untyped]
    def apply_flag_settings: (Hash[String, untyped] settings) -> Hash[String, untyped]
    def supported_commands: () -> Array[SlashCommand]
    def supported_models: () -> Array[ModelInfo]
    def supported_agents: () -> Array[AgentInfo]
    def mcp_server_status: () -> Array[McpServerStatus]
    def account_info: () -> AccountInfo
    def initialization_result: () -> InitializationResult
    def cancel_async_message: (String message_uuid) -> Hash[String, untyped]
    def get_settings: () -> Hash[String, untyped]
  end

  # Transport layer
  module Transport
    class Base
      def connect: (?streaming: bool, ?prompt: String?) -> void
      def close: () -> void
      def connected?: () -> bool
      def ready?: () -> bool
      def write: (String data) -> void
      def read_messages: () { (Hash[String, untyped]) -> void } -> void
                       | () -> Enumerator[Hash[String, untyped], void]
      def end_input: () -> void
    end

    class Subprocess < Base
      attr_reader cli_path: String
      attr_reader options: Options

      def initialize: (?options: Options?, ?cli_path: String?) -> void
      def connect: (?streaming: bool, ?prompt: String?) -> void
      def close: () -> void
      def connected?: () -> bool
      def ready?: () -> bool
      def write: (String data) -> void
      def read_messages: () { (Hash[String, untyped]) -> void } -> void
                       | () -> Enumerator[Hash[String, untyped], void]
      def end_input: () -> void
    end
  end

  # Spawn options for custom process creation (TypeScript SDK parity)
  class SpawnOptions < ImmutableRecord
    attr_reader command: String
    attr_reader args: Array[String]
    attr_reader cwd: String?
    attr_reader env: Hash[String, String]
    attr_reader abort_signal: AbortSignal?

    def initialize: (command: String, ?args: Array[String], ?cwd: String?, ?env: Hash[String, String], ?abort_signal: AbortSignal?) -> void
    def to_command_array: () -> Array[String]
  end

  # Interface for spawned processes (TypeScript SDK parity)
  module SpawnedProcess
    def write: (String data) -> void
    def read_stdout: () { (String) -> void } -> void
                   | () -> Enumerator[String, void]
    def read_stderr: () { (String) -> void } -> void
                   | () -> Enumerator[String, void]
    def close_stdin: () -> void
    def terminate: (?timeout: Numeric) -> void
    def kill: () -> void
    def running?: () -> bool
    def exit_status: () -> Integer?
    def close: () -> void
  end

  # Local spawned process using Open3.popen3 (TypeScript SDK parity)
  class LocalSpawnedProcess
    include SpawnedProcess

    attr_reader pid: Integer?
    attr_reader stdin: IO
    attr_reader stdout: IO
    attr_reader stderr: IO
    attr_reader wait_thread: Thread

    def self.spawn: (SpawnOptions spawn_options) -> LocalSpawnedProcess
    def initialize: (stdin: IO, stdout: IO, stderr: IO, wait_thread: Thread) -> void
    def write: (String data) -> void
    def read_stdout: () { (String) -> void } -> void
                   | () -> Enumerator[String, void]
    def read_stderr: () { (String) -> void } -> void
                   | () -> Enumerator[String, void]
    def close_stdin: () -> void
    def terminate: (?timeout: Numeric) -> void
    def kill: () -> void
    def running?: () -> bool
    def exit_status: () -> Integer?
    def killed?: () -> bool
    def close: () -> void
  end

  # Default spawn function
  DEFAULT_SPAWN: ^(SpawnOptions) -> LocalSpawnedProcess

  # MCP module
  module MCP
    def self.tool: (String name, String description, ?Hash[Symbol, untyped] schema, ?annotations: Hash[Symbol, untyped]?) { (Hash[String, untyped]) -> untyped } -> Tool
    def self.create_server: (name: String, ?tools: Array[Tool]) -> Server

    class Tool
      attr_reader name: String
      attr_reader description: String
      attr_reader schema: Hash[Symbol, untyped]
      attr_reader annotations: Hash[Symbol, untyped]?

      def initialize: (name: String, description: String, ?schema: Hash[Symbol, untyped], ?annotations: Hash[Symbol, untyped]?) { (Hash[String, untyped]) -> untyped } -> void
      def call: (Hash[String, untyped] arguments) -> Hash[Symbol, untyped]
      def to_mcp_definition: () -> Hash[Symbol, untyped]
    end

    class Server
      attr_reader name: String
      attr_reader tools: Hash[String, Tool]

      def initialize: (name: String, ?tools: Array[Tool], ?logger: Logger?) -> void
      def add_tool: (Tool tool) -> void
      def remove_tool: (String name) -> Tool?
      def handle_message: (Hash[String, untyped] message) -> Hash[Symbol, untyped]?
      def to_config: () -> Hash[Symbol, untyped]
    end
  end

  # V2 Session API - UNSTABLE
  # @alpha

  # V2 Session options (subset of full Options)
  class SessionOptions < ImmutableRecord
    attr_reader model: String
    attr_reader path_to_claude_code_executable: String?
    attr_reader env: Hash[String, String]?
    attr_reader allowed_tools: Array[String]?
    attr_reader disallowed_tools: Array[String]?
    attr_reader can_use_tool: (^(String, Hash[String, untyped], untyped) -> permission_result)?
    attr_reader hooks: Hash[String, Array[HookMatcher]]?
    attr_reader permission_mode: String?

    def initialize: (model: String, ?path_to_claude_code_executable: String?, ?env: Hash[String, String]?, ?allowed_tools: Array[String]?, ?disallowed_tools: Array[String]?, ?can_use_tool: (^(String, Hash[String, untyped], untyped) -> permission_result)?, ?hooks: Hash[String, Array[HookMatcher]]?, ?permission_mode: String?) -> void
  end

  # V2 Session interface for multi-turn conversations
  class V2Session
    attr_reader session_id: String?
    attr_reader options: SessionOptions

    def initialize: (Hash[Symbol, untyped] | SessionOptions options) -> void
    def send: (String | UserMessage message) -> void
    def stream: () -> Enumerator[message, void]
             | () { (message) -> void } -> void
    def close: () -> void
    def closed?: () -> bool
  end

  # V2 API module-level methods
  def self.unstable_v2_create_session: (Hash[Symbol, untyped] | SessionOptions options) -> V2Session
  def self.unstable_v2_resume_session: (String session_id, Hash[Symbol, untyped] | SessionOptions options) -> V2Session
  def self.unstable_v2_prompt: (String message, Hash[Symbol, untyped] | SessionOptions options) -> ResultMessage

  # Chainable, lazy query object for session transcript messages
  class SessionMessageRelation
    include Enumerable[SessionMessage]

    def initialize: (String session_id, ?dir: String?, ?limit: Integer?, ?offset: Integer?) -> void
    def where: (?limit: Integer?, ?offset: Integer?) -> SessionMessageRelation
    def each: () { (SessionMessage) -> void } -> void
            | () -> Enumerator[SessionMessage, void]
    def to_a: () -> Array[SessionMessage]
  end

  # Historical session finder with Rails-like API
  class Session
    attr_reader session_id: String
    attr_reader summary: String
    attr_reader last_modified: Integer
    attr_reader file_size: Integer
    attr_reader custom_title: String?
    attr_reader first_prompt: String?
    attr_reader git_branch: String?
    attr_reader cwd: String?

    def initialize: (SessionInfo session_info) -> void
    def messages: () -> SessionMessageRelation

    def self.find: (String session_id, ?dir: String?) -> Session?
    def self.all: () -> Array[Session]
    def self.where: (?dir: String?, ?limit: Integer?) -> Array[Session]
  end
end
